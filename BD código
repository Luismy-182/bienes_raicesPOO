SHOW DATABASES;
CREATE DATABASE bienes_raices;
USE bienes_raices;

CREATE TABLE propiedades(
    id INT(11) AUTO_INCREMENT,
    titulo VARCHAR(45),
    precio DECIMAL(10,2),
    imagen VARCHAR(200),
    descripcion LONGTEXT,
    habitaciones INT(1),
    wc INT(1),
    estacionamiento INT(1),
    creado DATE,
    vendedores_id INT(11),
    PRIMARY KEY (id),
    FOREIGN KEY(vendedores_id) REFERENCES vendedores(id)
);

CREATE TABLE vendedores(
    id INT(11) PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(45),
    apellido VARCHAR(45),
    telefono VARCHAR(10)

);


